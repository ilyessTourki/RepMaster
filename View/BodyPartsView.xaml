<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainSheet.View.BodyPartsView"
             BackgroundColor="Black">
    <ScrollView VerticalScrollBarVisibility="Always">

        <StackLayout>
            <CollectionView  ItemsSource="{Binding muscles}"
                    x:Name="MyCollectionView"
                    Margin="5">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame   CornerRadius="10"
                    Padding="2"
                    BorderColor="Black"
                   >
                            <Grid VerticalOptions="CenterAndExpand"
                        HorizontalOptions="FillAndExpand"
                        BackgroundColor="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="0.4*"/>
                                </Grid.ColumnDefinitions>
                                <Label Text="{Binding name}"
                           TextColor="White"
                           FontFamily="Horizon"
                           FontAttributes="Bold"
                           FontSize="20"
                            LineBreakMode="WordWrap"
                           Padding="5"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="CenterAndExpand"/>
                                <Frame HeightRequest="120"
                                    VerticalOptions="Center"
                                    WidthRequest="160"
                                    HorizontalOptions="EndAndExpand"
                                    CornerRadius="10"
                                    Grid.Column="1"
                                    BorderColor="Transparent">
                                    <Image
                                    Source="{Binding image}"
                                     WidthRequest="160"
                                    HeightRequest="120"
                                    Aspect="AspectFill"
                                    />

                                </Frame>

                            </Grid>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.muscleExercices, Source={x:Reference MuscleTypePage}}"
                                                  CommandParameter="{Binding muscleEnum}"/>
                            </Frame.GestureRecognizers>
                            <Frame.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#ffd500" Offset="0.0"/>
                                    <GradientStop Color="Black" Offset="0.5"/>
                                    <GradientStop Color="Black" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Frame.Background>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentView>

