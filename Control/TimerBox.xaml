<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrainSheet.Control.TimerBox">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
         <Label 
               Text="{Binding ElapsedTime, StringFormat='{0:hh\\:mm\\:ss}'}"
               TextColor="White"
               FontFamily="Horizon"
               HeightRequest="100"
                FontAttributes="Bold"
                VerticalTextAlignment="Center"
                VerticalOptions="EndAndExpand"
                HorizontalOptions="Center"
               FontSize="50"/>
        <Grid   HeightRequest="60"
                Margin="0,20"
                Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>
            <Frame   Style="{StaticResource ClockButtons}">
                <Label   Text="{Binding StartStopButtonText}"
                        Style="{StaticResource ButtonClock}"/>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleTimerCommand}" />
                </Frame.GestureRecognizers>
            </Frame>
            <Frame  Style="{StaticResource ClockButtons}"
                    Grid.Column="1">
                <Label  Text="&#xe042;"
                        Style="{StaticResource ButtonClock}"/>
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ResetTimerCommand}" />
                </Frame.GestureRecognizers>
            </Frame>
        </Grid>
    </Grid>
</ContentView>
