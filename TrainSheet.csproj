	</ItemGroup>
	<ItemGroup>
	  <None Remove="Model\ServiceModel\" />
	  <None Remove="Interface\" />
	  <None Remove="Control\ProfileControl\" />
	  <None Remove="Resources\Images\calisthenics\chesttowallhandstandpushup.png" />
