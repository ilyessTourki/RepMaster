	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)'=='Release|net8.0-ios'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<Codesignkey>Apple Distribution: ilyess Tourki (C9H3F56DNK)</Codesignkey>
